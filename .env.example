# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- Required ---
# The agent in api/api.py uses model_name="claude-sonnet-4-5", so an Anthropic key is required.
ANTHROPIC_API_KEY=""

# --- Optional ---
# Directory where swarms writes agent state, logs, and artifacts.
WORKSPACE_DIR="agent_workspace"

# Set to "false" to disable swarms telemetry.
SWARMS_TELEMETRY_ON="true"

# Only needed if you change model_name in api/api.py to a model from another provider.
# OPENAI_API_KEY=""
# GROQ_API_KEY=""
# GOOGLE_API_KEY=""
# MISTRAL_API_KEY=""
# COHERE_API_KEY=""
# TOGETHER_API_KEY=""
